From ec3e92ab048d0565d048afc60baf984bdaa529a4 Mon Sep 17 00:00:00 2001
From: Florian Maurer <fmaurer@disroot.org>
Date: Thu, 11 Jun 2026 00:00:03 +0200
Subject: [PATCH 7/7] docs: refresh GLUON_RELEASE comparison hint for apk

The site.mk examples (and the olsr CI fixture) all carry a comment
documenting the version-comparison rule that GLUON_RELEASE strings
must satisfy. opkg compare-versions no longer exists on 25.12; point
to apk version -t instead. The autoupdater's actual comparison logic
lives outside this repo, but the comment's purpose - to tell community
admins what ordering their release strings must follow - still holds.

Assisted-by: Claude:claude-opus-4-6
---
 contrib/ci/olsr-site/site.mk          | 2 +-
 docs/multidomain-site-example/site.mk | 2 +-
 docs/site-example/site.mk             | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/contrib/ci/olsr-site/site.mk b/contrib/ci/olsr-site/site.mk
index e50d404dae..273a0561c5 100644
--- a/contrib/ci/olsr-site/site.mk
+++ b/contrib/ci/olsr-site/site.mk
@@ -3,7 +3,7 @@
 ##	DEFAULT_GLUON_RELEASE
 #		version string to use for images
 #		gluon relies on
-#			opkg compare-versions "$1" '>>' "$2"
+#			apk version -t "$1" "$2"  # prints '>' when $1 is newer than $2
 #		to decide if a version is newer or not.
 
 DEFAULT_GLUON_RELEASE := 0.6+exp$(shell date '+%Y%m%d')
