From 3091c7c02e080fc3dba08b9a34ea49b8b12f291b Mon Sep 17 00:00:00 2001
From: Florian Maurer <f.maurer@outlook.de>
Date: Wed, 29 Oct 2025 09:38:00 +0100
Subject: [PATCH 2/6] gluon-client-bridge: configure 6ghz with open SSID
 instead of OWE ssid

Unencrypted client wifi is not allowed on 6GHz.
The configured SSID to broadcast needs to be the open SSID instead of OWE, as otherwise you end up with two SSID for the same network in the scan list.

Transition networks are hidden identified by the matching relation thru the transition IE. This is not available on 6GHz, thus the broadcasted SSID of the OWE network on 6GHz needs to be the Open SSID on a/g band.
---
 .../upgrade/320-gluon-client-bridge-wireless  | 38 +++++++++----------
 1 file changed, 18 insertions(+), 20 deletions(-)

diff --git a/package/gluon-client-bridge/luasrc/lib/gluon/upgrade/320-gluon-client-bridge-wireless b/package/gluon-client-bridge/luasrc/lib/gluon/upgrade/320-gluon-client-bridge-wireless
index b697301266..dabb083cfc 100755
--- a/package/gluon-client-bridge/luasrc/lib/gluon/upgrade/320-gluon-client-bridge-wireless
+++ b/package/gluon-client-bridge/luasrc/lib/gluon/upgrade/320-gluon-client-bridge-wireless
@@ -27,15 +27,13 @@ local function is_disabled(radio, config)
 	return not util.contains(roles, 'client') or disable_client
 end
 
-local function configure_ap(radio, index, config, radio_name)
+local function configure_ap(radio, index, radio_name, ssid)
 	local name = 'client_' .. radio_name
 	local suffix = radio_name:match('^radio(%d+)$')
 
-	local ap = config.ap
-
 	local macaddr = wireless.get_wlan_mac('client', index, radio)
 
-	if not ap.ssid() or not macaddr or not suffix then
+	if not ssid or not macaddr or not suffix then
 		return
 	end
 
@@ -43,18 +41,16 @@ local function configure_ap(radio, index, config, radio_name)
 		device = radio_name,
 		network = 'client',
 		mode = 'ap',
-		ssid = ap.ssid(),
+		ssid = ssid,
 		macaddr = macaddr,
 		ifname = 'client' .. suffix,
 	})
 end
 
-local function configure_owe(radio, index, config, radio_name)
+local function configure_owe(radio, index, radio_name, ssid)
 	local name = 'owe_' .. radio_name
 	local suffix = radio_name:match('^radio(%d+)$')
 
-	local ap = config.ap
-
 	-- Don't configure OWE in case our device
 	-- can't do MFP, as it's mandatory for OWE.
 	if not wireless.device_supports_mfp(uci) then
@@ -63,7 +59,7 @@ local function configure_owe(radio, index, config, radio_name)
 
 	local macaddr = wireless.get_wlan_mac('owe', index, radio)
 
-	if not ap.owe_ssid() or not macaddr or not suffix then
+	if not ssid or not macaddr or not suffix then
 		return
 	end
 
@@ -71,7 +67,7 @@ local function configure_owe(radio, index, config, radio_name)
 		device = radio_name,
 		network = 'client',
 		mode = 'ap',
-		ssid = ap.owe_ssid(),
+		ssid = ssid,
 		macaddr = macaddr,
 		ifname = 'owe' .. suffix,
 		encryption = 'owe',
@@ -79,8 +75,7 @@ local function configure_owe(radio, index, config, radio_name)
 	})
 end
 
-local function configure_owe_transition_mode(config, radio_name)
-	local ap = config.ap
+local function configure_owe_transition_mode(radio_name)
 
 	-- Don't configure OWE in case our device
 	-- can't do MFP, as it's mandatory for OWE.
@@ -88,10 +83,6 @@ local function configure_owe_transition_mode(config, radio_name)
 		return
 	end
 
-	if not ap.owe_transition_mode(false) then
-		return
-	end
-
 	local name_client = 'client_' .. radio_name
 	local name_owe = 'owe_' .. radio_name
 
@@ -110,11 +101,18 @@ end
 
 wireless.foreach_radio(uci, function(radio, index, config)
 	local radio_name = radio['.name']
-	if not is_disabled(radio, config) then
-		configure_ap(radio, index, config, radio_name)
 
-		configure_owe(radio, index, config, radio_name)
-		configure_owe_transition_mode(config, radio_name)
+	if not is_disabled(radio, config)  then
+		-- 6ghz does not support unencrypted client ifaces
+		if radio.band == '6g' then
+			configure_owe(radio, index, radio_name, config.ap.ssid())
+		else
+			configure_ap(radio, index, radio_name, config.ap.ssid())
+			configure_owe(radio, index, radio_name, config.ap.owe_ssid())
+			if config.ap.owe_transition_mode(false) then
+				configure_owe_transition_mode(radio_name)
+			end
+		end
 	end
 end)
 

From fda080aa4a4a241fe29506de6cbd1114ad8b799d Mon Sep 17 00:00:00 2001
