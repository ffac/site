From 51a9440eb4547625849fb6aaa179b28c66b1951c Mon Sep 17 00:00:00 2001
From: Florian Maurer <f.maurer@outlook.de>
Date: Wed, 8 Oct 2025 22:45:38 +0200
Subject: [PATCH 4/6] gluon-private-wifi: fixup private wifi encryption if set
 to something else than sae

---
 .../luasrc/lib/gluon/upgrade/325-gluon-private-wifi           | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/package/gluon-private-wifi/luasrc/lib/gluon/upgrade/325-gluon-private-wifi b/package/gluon-private-wifi/luasrc/lib/gluon/upgrade/325-gluon-private-wifi
index f02377b041..ea97b87721 100755
--- a/package/gluon-private-wifi/luasrc/lib/gluon/upgrade/325-gluon-private-wifi
+++ b/package/gluon-private-wifi/luasrc/lib/gluon/upgrade/325-gluon-private-wifi
@@ -14,6 +14,10 @@ local function configure_private_wifi(radio, index)
 	end
 
 	local encryption = uci:get('gluon', 'wireless', 'private_encryption')
+	-- 6GHz radio requires usage of WPA3/SAE
+	if radio.band == '6g' then
+		encryption = 'sae'
+	end
 	local ssid = uci:get('gluon', 'wireless', 'private_ssid')
 	local key = uci:get('gluon', 'wireless', 'private_key')
 	local mfp = wireless.device_supports_mfp(uci) and uci:get('gluon', 'wireless', 'private_mfp')

